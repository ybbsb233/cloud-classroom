erDiagram
    APP_USER ||--o{ PRACTICE : submits
    COURSE ||--o{ CHAPTER : contains
    CHAPTER ||--o{ KNOWLEDGE_POINT : contains
    CHAPTER ||--o{ QUESTION : owns
    QUESTION ||--|{ QUESTION_KNOWLEDGE : tags
    KNOWLEDGE_POINT ||--o{ QUESTION_KNOWLEDGE : linked
    COURSE ||--o{ PRACTICE : selected
    CHAPTER |o--o{ PRACTICE : fixed_set
    PRACTICE ||--|{ PRACTICE_ITEM : contains
    QUESTION ||--o{ PRACTICE_ITEM : answered
    APP_USER {
        bigint id PK
        varchar username UK
        varchar real_name
        varchar password_hash
        varchar role
        tinyint enabled
        tinyint must_change_password
        bigint token_version
    }
    COURSE {
        bigint id PK
        varchar name UK
        int sort_order
    }
    CHAPTER {
        bigint id PK
        bigint course_id FK
        varchar name
        int sort_order
        tinyint is_current
    }
    KNOWLEDGE_POINT {
        bigint id PK
        bigint chapter_id FK
        varchar name
        int sort_order
    }
    QUESTION {
        bigint id PK
        bigint chapter_id FK
        varchar question_type
        text stem
        varchar option_a
        varchar option_b
        varchar option_c
        varchar option_d
        varchar correct_answer
        text explanation
    }
    QUESTION_KNOWLEDGE {
        bigint question_id PK,FK
        bigint knowledge_id PK,FK
    }
    PRACTICE {
        bigint id PK
        bigint student_id FK
        bigint course_id FK
        bigint chapter_id FK
        tinyint archived
        varchar source_type
        varchar status
        int question_count
        int correct_count
        datetime started_at
        datetime submitted_at
    }
    PRACTICE_ITEM {
        bigint id PK
        bigint practice_id FK
        bigint question_id FK
        int order_no
        varchar option_order
        varchar selected_answer
        tinyint is_correct
    }
